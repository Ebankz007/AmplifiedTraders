# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
# deploy scratch: the staging build is swapped into .next only when it is
# complete, so a failed build never takes the live bundle down.
/.next-staging/
/.next.previous/
/out/
next-env.d.ts

# production
/build

# prisma generated client
/lib/generated/

# runtime / uploads
/public/uploads/*
!/public/uploads/.gitkeep

# env
.env
.env.local
.env.*.local

# deploy state (server-side only)
/deploy.log
/deploy.env

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
tsconfig.tsbuildinfo
coverage/
