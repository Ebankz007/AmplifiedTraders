# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3600"
NEXT_PUBLIC_SITE_NAME="Amplified Traders"

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="CHANGE_ME_32_BYTES_HEX"

